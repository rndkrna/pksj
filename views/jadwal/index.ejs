<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.2/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/public/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container-fluid">
    <div class="row">
      <%- include('../partials/sidebar') %>

      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h4 class="fw-bold"><i class="bi bi-calendar3 text-primary me-2"></i>Jadwal Perkuliahan Mahasiswa & Dosen</h4>
          <span class="badge bg-secondary fs-6 px-3 py-2">TA <%= tahunAjaran %> (<%= semesterType.toUpperCase() %>)</span>
        </div>

        <div class="card border-0 shadow-sm">
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Hari</th>
                    <th>Waktu (WIB)</th>
                    <th>Kode MK</th>
                    <th>Mata Kuliah</th>
                    <th>Kelas</th>
                    <th>SKS</th>
                    <th>Ruangan</th>
                    <% if (user.role !== 'dosen') { %>
                      <th>Dosen Pengampu</th>
                    <% } else { %>
                      <th>Peserta Terdaftar</th>
                    <% } %>
                  </tr>
                </thead>
                <tbody>
                  <% if (jadwal.length === 0) { %>
                    <tr><td colspan="8" class="text-center py-4 text-muted">Belum ada jadwal perkuliahan terdaftar.</td></tr>
                  <% } %>
                  <% jadwal.forEach(j => { %>
                    <tr>
                      <td>
                        <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-2 py-1">
                          <%= j.hari %>
                        </span>
                      </td>
                      <td class="fw-semibold">
                        <i class="bi bi-clock me-1 text-secondary"></i>
                        <%= j.jam_mulai.substring(0, 5) %> - <%= j.jam_selesai.substring(0, 5) %>
                      </td>
                      <td><code><%= j.kode_mk %></code></td>
                      <td class="fw-semibold"><%= j.nama_mk %></td>
                      <td><span class="badge bg-secondary"><%= j.kode_kelas %></span></td>
                      <td><%= j.sks %> SKS</td>
                      <td><i class="bi bi-geo-alt-fill text-danger me-1"></i><%= j.ruangan %></td>
                      <% if (user.role !== 'dosen') { %>
                        <td class="small"><%= j.nama_dosen %></td>
                      <% } else { %>
                        <td>
                          <span class="badge bg-info text-dark"><%= j.jumlah_mahasiswa %> Mahasiswa</span>
                        </td>
                      <% } %>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/public/js/app.js"></script>
</body>
</html>

