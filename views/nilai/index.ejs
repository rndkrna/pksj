<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.2/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/public/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container-fluid">
    <div class="row">
      <%- include('../partials/sidebar') %>

      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
        <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
          <div class="alert alert-success alert-dismissible fade show mt-2"><i class="bi bi-check-circle-fill me-2"></i><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
          <div class="alert alert-danger alert-dismissible fade show mt-2"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h4 class="fw-bold">
            <i class="bi bi-award-fill text-success me-2"></i><%= role === 'mahasiswa' ? 'Transkrip Nilai Akademik' : 'Pengelolaan Nilai Mahasiswa' %>
          </h4>
          <% if (role === 'mahasiswa') { %>
            <span class="badge bg-success fs-6 px-3 py-2">IPK Kumulatif: <%= ipk %></span>
          <% } %>
        </div>

        <% if (role === 'mahasiswa') { %>
          <!-- Tampilan Mahasiswa (CT-03 Isolasi Data: Hanya milik sendiri) -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
              <div>Transkrip Hasil Belajar: <strong><%= mahasiswa.nama_lengkap %></strong> (NIM: <%= mahasiswa.nim %>)</div>
              <span class="text-muted small"><i class="bi bi-lock-fill text-success me-1"></i>Protected Academic Record (A-01)</span>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Kode MK</th>
                      <th>Nama Mata Kuliah</th>
                      <th>SKS</th>
                      <th>Semester</th>
                      <th>Tugas (30%)</th>
                      <th>UTS (30%)</th>
                      <th>UAS (40%)</th>
                      <th>Nilai Akhir</th>
                      <th>Huruf</th>
                      <th>Bobot</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (transcript.length === 0) { %>
                      <tr><td colspan="10" class="text-center py-4 text-muted">Belum ada nilai yang dipublikasikan.</td></tr>
                    <% } %>
                    <% transcript.forEach(n => { %>
                      <tr>
                        <td><code><%= n.kode_mk %></code></td>
                        <td class="fw-semibold"><%= n.nama_mk %></td>
                        <td><%= n.sks %></td>
                        <td><%= n.tahun_ajaran %> <%= n.semester_type %></td>
                        <td><%= n.nilai_tugas !== null ? Number(n.nilai_tugas).toFixed(1) : '-' %></td>
                        <td><%= n.nilai_uts !== null ? Number(n.nilai_uts).toFixed(1) : '-' %></td>
                        <td><%= n.nilai_uas !== null ? Number(n.nilai_uas).toFixed(1) : '-' %></td>
                        <td><strong><%= n.nilai_akhir !== null ? Number(n.nilai_akhir).toFixed(2) : '-' %></strong></td>
                        <td>
                          <% if (n.huruf_mutu) { %>
                            <span class="badge bg-<%= gradeColor(n.huruf_mutu) %>"><%= n.huruf_mutu %></span>
                          <% } else { %>
                            <span class="text-muted">-</span>
                          <% } %>
                        </td>
                        <td><%= n.bobot !== null ? Number(n.bobot).toFixed(2) : '-' %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        <% } else { %>
          <!-- Tampilan Dosen: Pilih Kelas untuk Input Nilai -->
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-bold">
              Pilih Kelas Perkuliahan untuk Mengisi / Mengubah Nilai Mahasiswa
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Kode MK</th>
                      <th>Nama Mata Kuliah</th>
                      <th>SKS</th>
                      <th>Kelas</th>
                      <th>Mahasiswa Terdaftar</th>
                      <th>Aksi</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (kelas.length === 0) { %>
                      <tr><td colspan="6" class="text-center py-4 text-muted">Tidak ada kelas yang diampu.</td></tr>
                    <% } %>
                    <% kelas.forEach(k => { %>
                      <tr>
                        <td><code><%= k.kode_mk %></code></td>
                        <td class="fw-semibold"><%= k.nama_mk %></td>
                        <td><%= k.sks %> SKS</td>
                        <td><span class="badge bg-secondary"><%= k.kode_kelas %></span></td>
                        <td>
                          <span class="badge bg-info text-dark">
                            <i class="bi bi-people-fill me-1"></i><%= k.jumlah_mahasiswa %> Peserta
                          </span>
                        </td>
                        <td>
                          <a href="/nilai/input/<%= k.id %>" class="btn btn-sm btn-primary">
                            <i class="bi bi-pencil-square me-1"></i>Kelola Nilai Mahasiswa
                          </a>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        <% } %>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/public/js/app.js"></script>
</body>
</html>

