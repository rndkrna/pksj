<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.2/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/public/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container-fluid">
    <div class="row">
      <%- include('../partials/sidebar') %>

      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
        <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
          <div class="alert alert-success alert-dismissible fade show mt-2"><i class="bi bi-check-circle-fill me-2"></i><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
          <div class="alert alert-danger alert-dismissible fade show mt-2"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h4 class="fw-bold"><i class="bi bi-journal-check text-primary me-2"></i>Kartu Rencana Studi (KRS)</h4>
          <div>
            <span class="badge bg-primary fs-6 px-3 py-2 me-2">Beban SKS: <%= totalSKS %> / 24</span>
            <a href="/krs/isi" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Ambil Mata Kuliah</a>
          </div>
        </div>

        <!-- Info Mahasiswa -->
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-body p-3 bg-light rounded">
            <div class="row">
              <div class="col-md-6">
                <div>Mahasiswa: <strong><%= mahasiswa.nama_lengkap %></strong> (NIM: <%= mahasiswa.nim %>)</div>
                <div>Program Studi: <%= mahasiswa.program_studi %></div>
              </div>
              <div class="col-md-6 text-md-end">
                <div>Tahun Ajaran: <strong><%= tahunAjaran %></strong></div>
                <div>Semester: <strong><%= semesterType.toUpperCase() %></strong></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tabel KRS -->
        <div class="card border-0 shadow-sm">
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th>No</th>
                    <th>Kode MK</th>
                    <th>Nama Mata Kuliah</th>
                    <th>SKS</th>
                    <th>Kelas</th>
                    <th>Dosen Pengampu</th>
                    <th>Status</th>
                    <th class="text-center">Aksi</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (krs.length === 0) { %>
                    <tr>
                      <td colspan="8" class="text-center py-4 text-muted">
                        KRS Anda masih kosong. Silakan klik tombol <strong>"Ambil Mata Kuliah"</strong> untuk memilih mata kuliah.
                      </td>
                    </tr>
                  <% } %>
                  <% krs.forEach((item, idx) => { %>
                    <tr>
                      <td><%= idx + 1 %></td>
                      <td><code><%= item.kode_mk %></code></td>
                      <td class="fw-semibold"><%= item.nama_mk %></td>
                      <td><%= item.sks %></td>
                      <td><span class="badge bg-secondary"><%= item.kode_kelas %></span></td>
                      <td class="small"><%= item.nama_dosen %></td>
                      <td><span class="badge bg-success">Disetujui</span></td>
                      <td class="text-center">
                        <form action="/krs/delete/<%= item.id %>" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin membatalkan mata kuliah <%= item.nama_mk %>?')">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2" title="Batalkan Pengambilan">
                            <i class="bi bi-trash3-fill"></i> Batal
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
                <tfoot class="table-light">
                  <tr>
                    <td colspan="3" class="text-end fw-bold">Total SKS Diambil:</td>
                    <td class="fw-bold text-primary"><%= totalSKS %> SKS</td>
                    <td colspan="4"></td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/public/js/app.js"></script>
</body>
</html>

