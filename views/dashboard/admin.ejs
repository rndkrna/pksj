<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.2/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/public/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container-fluid">
    <div class="row">
      <%- include('../partials/sidebar') %>

      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
        <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
          <div class="alert alert-success alert-dismissible fade show mt-2"><i class="bi bi-check-circle-fill me-2"></i><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
          <div class="alert alert-danger alert-dismissible fade show mt-2"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h4 class="fw-bold"><i class="bi bi-shield-check text-danger me-2"></i>Security & Administration Center</h4>
          <div>
            <span class="badge bg-danger fs-6 px-3 py-2 me-2">Zona Manajemen (TB-3)</span>
            <a href="/admin/audit-log" class="btn btn-outline-dark btn-sm"><i class="bi bi-eye me-1"></i>Audit Viewer</a>
          </div>
        </div>

        <!-- Metric Stat Cards -->
        <% const roleCounts = {}; userCounts.forEach(r => roleCounts[r.role] = r.count); %>
        <div class="row mb-4">
          <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm border-start border-primary border-4 h-100">
              <div class="card-body">
                <div class="text-secondary small fw-semibold text-uppercase">Total Mahasiswa</div>
                <h2 class="fw-bold mb-0 text-primary mt-2"><%= roleCounts['mahasiswa'] || 0 %></h2>
                <div class="small text-muted mt-1">Akun Terdaftar</div>
              </div>
            </div>
          </div>

          <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm border-start border-warning border-4 h-100">
              <div class="card-body">
                <div class="text-secondary small fw-semibold text-uppercase">Total Dosen</div>
                <h2 class="fw-bold mb-0 text-warning mt-2"><%= roleCounts['dosen'] || 0 %></h2>
                <div class="small text-muted mt-1">Dosen Pengampu</div>
              </div>
            </div>
          </div>

          <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm border-start border-danger border-4 h-100">
              <div class="card-body">
                <div class="text-secondary small fw-semibold text-uppercase">Administrator</div>
                <h2 class="fw-bold mb-0 text-danger mt-2"><%= roleCounts['admin'] || 0 %></h2>
                <div class="small text-muted mt-1">Hak Akses Penuh</div>
              </div>
            </div>
          </div>

          <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm border-start border-dark border-4 h-100">
              <div class="card-body">
                <div class="text-secondary small fw-semibold text-uppercase">Security Interventions</div>
                <% const blockedEvent = logCounts.find(l => l.status === 'blocked'); %>
                <h2 class="fw-bold mb-0 text-danger mt-2"><%= blockedEvent ? blockedEvent.count : 0 %></h2>
                <div class="small text-muted mt-1">Percobaan Diblokir</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Status Hardening & Risk Matrix Overview -->
        <div class="row mb-4">
          <div class="col-lg-6 mb-3">
            <div class="card border-0 shadow-sm h-100">
              <div class="card-header bg-white fw-bold">
                <i class="bi bi-shield-fill-check text-success me-2"></i>Status Kontrol Keamanan (Fase 1 & Fase 2)
              </div>
              <div class="card-body">
                <ul class="list-group list-group-flush small">
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div><strong>R-01: Autentikasi</strong> (bcrypt, rate limit 5x, lockout 15m)</div>
                    <span class="badge bg-success">AKTIF</span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div><strong>R-02: Integritas Nilai</strong> (Kueri Parameterized, Validasi Server)</div>
                    <span class="badge bg-success">AKTIF</span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div><strong>R-03: Log Audit</strong> (Append-only terpusat, Winston JSON)</div>
                    <span class="badge bg-success">AKTIF</span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div><strong>R-04: Kerahasiaan</strong> (Helmet security headers, HttpOnly/SameSite)</div>
                    <span class="badge bg-success">AKTIF</span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div><strong>R-05: Ketersediaan</strong> (Express Rate Limiter global)</div>
                    <span class="badge bg-success">AKTIF</span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div><strong>R-06: RBAC</strong> (Otorisasi tiap endpoint & isolasi data)</div>
                    <span class="badge bg-success">AKTIF</span>
                  </li>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div><strong>R-07: Sesi</strong> (Regenerasi session ID, timeout 30 menit)</div>
                    <span class="badge bg-success">AKTIF</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <div class="col-lg-6 mb-3">
            <div class="card border-0 shadow-sm h-100">
              <div class="card-header bg-white fw-bold">
                <i class="bi bi-terminal text-primary me-2"></i>Aksi Cepat Administrator
              </div>
              <div class="card-body">
                <div class="d-grid gap-2">
                  <a href="/admin/users" class="btn btn-outline-primary text-start p-3">
                    <div class="fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Kelola Akun Pengguna</div>
                    <div class="text-secondary small">Tambah user baru, reset lockout, aktif/nonaktifkan akun</div>
                  </a>
                  <a href="/admin/audit-log" class="btn btn-outline-dark text-start p-3">
                    <div class="fw-bold"><i class="bi bi-journal-code me-2"></i>Periksa Log Keamanan Sistem</div>
                    <div class="text-secondary small">Lihat jejak audit login, perubahan data, dan alert pelanggaran</div>
                  </a>
                  <div class="p-3 bg-light rounded border small">
                    <div class="fw-bold text-secondary mb-1"><i class="bi bi-hdd-network me-1"></i>Backup Database (R-08):</div>
                    <code>npm run backup</code> atau jalankan <code>node scripts/backup.js</code>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Recent Audit Log Table -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-bold"><i class="bi bi-clock-history me-2 text-danger"></i>Catatan Audit Terbaru (Immutable Log)</span>
            <a href="/admin/audit-log" class="btn btn-sm btn-outline-primary">Lihat Selengkapnya</a>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Waktu</th>
                    <th>Pengguna</th>
                    <th>Peran</th>
                    <th>Aksi / Peristiwa</th>
                    <th>Detail Singkat</th>
                    <th>IP</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentLogs.forEach(log => { %>
                    <tr class="<%= log.status === 'blocked' ? 'table-danger' : log.status === 'failed' ? 'table-warning' : '' %>">
                      <td class="small text-nowrap"><%= formatDate(log.created_at) %></td>
                      <td><code><%= log.username %></code></td>
                      <td><span class="badge bg-secondary"><%= log.role %></span></td>
                      <td class="small fw-semibold"><%= log.action %></td>
                      <td class="small text-truncate" style="max-width: 250px;" title="<%= log.details %>"><%= log.details || '-' %></td>
                      <td class="small text-muted"><%= log.ip_address %></td>
                      <td>
                        <span class="badge bg-<%= log.status === 'success' ? 'success' : log.status === 'blocked' ? 'danger' : 'warning' %>">
                          <%= log.status.toUpperCase() %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/public/js/app.js"></script>
</body>
</html>

