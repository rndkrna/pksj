<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.2/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/public/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container-fluid">
    <div class="row">
      <%- include('../partials/sidebar') %>

      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
        <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
          <div class="alert alert-success alert-dismissible fade show mt-2"><i class="bi bi-check-circle-fill me-2"></i><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
          <div class="alert alert-danger alert-dismissible fade show mt-2"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h4 class="fw-bold"><i class="bi bi-person-workspace text-primary me-2"></i>Portal Akademik Mahasiswa</h4>
          <span class="badge bg-primary fs-6 px-3 py-2">Tahun Ajaran <%= tahunAjaran %> (<%= semesterType.toUpperCase() %>)</span>
        </div>

        <!-- Profil Mahasiswa -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body p-4">
            <div class="row align-items-center">
              <div class="col-auto">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; font-size: 32px;">
                  <i class="bi bi-mortarboard-fill"></i>
                </div>
              </div>
              <div class="col">
                <h5 class="fw-bold mb-1"><%= mahasiswa.nama_lengkap %></h5>
                <div class="text-secondary small">
                  <span class="me-3"><i class="bi bi-card-text me-1"></i>NIM: <strong><%= mahasiswa.nim %></strong></span>
                  <span class="me-3"><i class="bi bi-building me-1"></i><%= mahasiswa.program_studi %></span>
                  <span><i class="bi bi-calendar-event me-1"></i>Angkatan: <%= mahasiswa.angkatan %></span>
                </div>
              </div>
              <div class="col-auto">
                <span class="badge bg-success px-3 py-2 fs-6"><i class="bi bi-check2-circle me-1"></i>STATUS: AKTIF</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Metric Cards -->
        <div class="row mb-4">
          <div class="col-md-4 mb-3">
            <div class="card border-0 shadow-sm border-start border-primary border-4 h-100">
              <div class="card-body">
                <div class="text-secondary small fw-semibold text-uppercase">Total SKS Semester Ini</div>
                <div class="d-flex align-items-baseline mt-2">
                  <h2 class="fw-bold mb-0 text-primary"><%= totalSKS %></h2>
                  <span class="text-secondary ms-2 small">/ Maks 24 SKS</span>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-4 mb-3">
            <div class="card border-0 shadow-sm border-start border-success border-4 h-100">
              <div class="card-body">
                <div class="text-secondary small fw-semibold text-uppercase">Indeks Prestasi Kumulatif (IPK)</div>
                <div class="d-flex align-items-baseline mt-2">
                  <h2 class="fw-bold mb-0 text-success"><%= ipk %></h2>
                  <span class="text-secondary ms-2 small">Skala 4.00</span>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-4 mb-3">
            <div class="card border-0 shadow-sm border-start border-info border-4 h-100">
              <div class="card-body">
                <div class="text-secondary small fw-semibold text-uppercase">Mata Kuliah Terdaftar</div>
                <div class="d-flex align-items-baseline mt-2">
                  <h2 class="fw-bold mb-0 text-info"><%= krs.length %></h2>
                  <span class="text-secondary ms-2 small">Kelas Perkuliahan</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Ringkasan KRS -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-bold"><i class="bi bi-journal-text text-primary me-2"></i>Mata Kuliah Semester Ini</span>
            <a href="/krs/isi" class="btn btn-outline-primary btn-sm"><i class="bi bi-plus-circle me-1"></i>Tambah KRS</a>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Kode MK</th>
                    <th>Nama Mata Kuliah</th>
                    <th>SKS</th>
                    <th>Kelas</th>
                    <th>Dosen Pengampu</th>
                    <th>Nilai</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (krs.length === 0) { %>
                    <tr><td colspan="7" class="text-center py-4 text-secondary">Belum ada mata kuliah yang diambil. Silakan isi KRS.</td></tr>
                  <% } %>
                  <% krs.forEach(item => { %>
                    <tr>
                      <td><code><%= item.kode_mk %></code></td>
                      <td class="fw-semibold"><%= item.nama_mk %></td>
                      <td><%= item.sks %></td>
                      <td><span class="badge bg-secondary"><%= item.kode_kelas %></span></td>
                      <td class="small"><%= item.nama_dosen %></td>
                      <td>
                        <% if (item.huruf_mutu) { %>
                          <span class="badge bg-<%= gradeColor(item.huruf_mutu) %>"><%= item.huruf_mutu %> (<%= item.nilai_akhir %>)</span>
                        <% } else { %>
                          <span class="text-muted small">Belum Keluar</span>
                        <% } %>
                      </td>
                      <td><span class="badge bg-success">Disetujui</span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/public/js/app.js"></script>
</body>
</html>

