<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.2/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/public/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container-fluid">
    <div class="row">
      <%- include('../partials/sidebar') %>

      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
        <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
          <div class="alert alert-success alert-dismissible fade show mt-2"><i class="bi bi-check-circle-fill me-2"></i><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
          <div class="alert alert-danger alert-dismissible fade show mt-2"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h4 class="fw-bold"><i class="bi bi-person-badge text-warning me-2"></i>Portal Akademik Dosen</h4>
          <span class="badge bg-warning text-dark fs-6 px-3 py-2">TA <%= tahunAjaran %> (<%= semesterType.toUpperCase() %>)</span>
        </div>

        <!-- Profil Dosen -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body p-4">
            <div class="row align-items-center">
              <div class="col-auto">
                <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; font-size: 32px;">
                  <i class="bi bi-person-video3"></i>
                </div>
              </div>
              <div class="col">
                <h5 class="fw-bold mb-1"><%= dosen.nama_lengkap %></h5>
                <div class="text-secondary small">
                  <span class="me-3"><i class="bi bi-person-vcard me-1"></i>NIDN: <strong><%= dosen.nidn %></strong></span>
                  <span class="me-3"><i class="bi bi-award me-1"></i><%= dosen.jabatan_fungsional %></span>
                  <span><i class="bi bi-shield-check text-success me-1"></i>Keahlian: <%= dosen.bidang_keahlian %></span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Security Notice -->
        <div class="security-alert-box">
          <div class="fw-bold text-success mb-1">
            <i class="bi bi-shield-lock-fill me-1"></i>Prinsip Zero Trust & Otorisasi Berbasis Objek (R-02 / R-06)
          </div>
          <div class="small text-secondary">
            Anda hanya memiliki otorisasi untuk melihat dan menginput nilai pada kelas perkuliahan yang ditugaskan kepada Anda secara sah. Setiap perubahan nilai secara otomatis diverifikasi server-side dan dicatat ke Audit Trail.
          </div>
        </div>

        <!-- Daftar Kelas yang Diampu -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white">
            <span class="fw-bold"><i class="bi bi-journal-bookmark-fill text-warning me-2"></i>Kelas Perkuliahan yang Diampu</span>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Kode MK</th>
                    <th>Nama Mata Kuliah</th>
                    <th>SKS</th>
                    <th>Kelas</th>
                    <th>Kapasitas</th>
                    <th>Peserta Aktif</th>
                    <th>Aksi Nilai</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (kelas.length === 0) { %>
                    <tr><td colspan="7" class="text-center py-4 text-secondary">Tidak ada kelas yang diampu pada semester ini.</td></tr>
                  <% } %>
                  <% kelas.forEach(k => { %>
                    <tr>
                      <td><code><%= k.kode_mk %></code></td>
                      <td class="fw-semibold"><%= k.nama_mk %></td>
                      <td><%= k.sks %> SKS</td>
                      <td><span class="badge bg-secondary"><%= k.kode_kelas %></span></td>
                      <td><%= k.kapasitas %> Mhs</td>
                      <td>
                        <span class="badge bg-info text-dark">
                          <i class="bi bi-people-fill me-1"></i><%= k.jumlah_mahasiswa %> Terdaftar
                        </span>
                      </td>
                      <td>
                        <a href="/nilai/input/<%= k.id %>" class="btn btn-sm btn-primary">
                          <i class="bi bi-pencil-square me-1"></i>Input / Edit Nilai
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/public/js/app.js"></script>
</body>
</html>

