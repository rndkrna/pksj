<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.2/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/public/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container-fluid">
    <div class="row">
      <%- include('../partials/sidebar') %>

      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
        <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
          <div class="alert alert-success alert-dismissible fade show mt-2"><i class="bi bi-check-circle-fill me-2"></i><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
          <div class="alert alert-danger alert-dismissible fade show mt-2"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h4 class="fw-bold"><i class="bi bi-people-fill text-danger me-2"></i>Manajemen Akun Pengguna</h4>
          <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalTambahUser">
            <i class="bi bi-person-plus-fill me-1"></i>Tambah Pengguna Baru
          </button>
        </div>

        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-bold">Daftar Akun Pengguna Terdaftar</span>
            <span class="badge bg-secondary"><%= users.length %> Total Akun</span>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Username</th>
                    <th>Nama Lengkap</th>
                    <th>Email</th>
                    <th>Peran</th>
                    <th>Status Akun</th>
                    <th>Percobaan Gagal</th>
                    <th>Terakhir Masuk</th>
                    <th class="text-center">Aksi Keamanan</th>
                  </tr>
                </thead>
                <tbody>
                  <% users.forEach(u => { %>
                    <% const isLocked = u.locked_until && new Date(u.locked_until) > new Date(); %>
                    <tr class="<%= isLocked ? 'table-danger' : !u.is_active ? 'table-secondary' : '' %>">
                      <td><code><%= u.username %></code></td>
                      <td class="fw-semibold"><%= u.nama_lengkap %></td>
                      <td class="small text-muted"><%= u.email || '-' %></td>
                      <td>
                        <span class="badge bg-<%= u.role === 'admin' ? 'danger' : u.role === 'dosen' ? 'warning text-dark' : 'info text-dark' %>">
                          <%= u.role.toUpperCase() %>
                        </span>
                      </td>
                      <td>
                        <% if (isLocked) { %>
                          <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>TERKUNCI</span>
                        <% } else if (u.is_active) { %>
                          <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Aktif</span>
                        <% } else { %>
                          <span class="badge bg-secondary"><i class="bi bi-slash-circle me-1"></i>Nonaktif</span>
                        <% } %>
                      </td>
                      <td class="text-center">
                        <% if (u.login_attempts > 0) { %>
                          <span class="badge bg-warning text-dark"><%= u.login_attempts %>x Gagal</span>
                        <% } else { %>
                          <span class="text-muted small">0</span>
                        <% } %>
                      </td>
                      <td class="small text-muted"><%= u.last_login ? formatDate(u.last_login) : 'Belum pernah' %></td>
                      <td class="text-center">
                        <div class="btn-group btn-group-sm">
                          <% if (u.id !== user.id) { %>
                            <!-- Toggle Active Status -->
                            <form action="/admin/users/toggle/<%= u.id %>" method="POST" class="d-inline">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <button type="submit" class="btn btn-<%= u.is_active ? 'outline-warning' : 'outline-success' %> btn-sm" title="<%= u.is_active ? 'Nonaktifkan Akun' : 'Aktifkan Akun' %>">
                                <i class="bi bi-<%= u.is_active ? 'person-slash' : 'person-check' %>"></i>
                              </button>
                            </form>

                            <!-- Unlock Account if Locked -->
                            <% if (isLocked || u.login_attempts > 0) { %>
                              <form action="/admin/users/unlock/<%= u.id %>" method="POST" class="d-inline ms-1">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Buka Kunci Akun (Reset Lockout)">
                                  <i class="bi bi-unlock-fill"></i> Buka Kunci
                                </button>
                              </form>
                            <% } %>
                          <% } else { %>
                            <span class="badge bg-light text-secondary border">Akun Anda</span>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Modal Tambah User -->
        <div class="modal fade" id="modalTambahUser" tabindex="-1">
          <div class="modal-dialog">
            <div class="modal-content">
              <form method="POST" action="/admin/users/create">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="modal-header">
                  <h5 class="modal-title fw-bold"><i class="bi bi-person-plus-fill text-primary me-2"></i>Tambah Pengguna Baru</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                  <div class="mb-3">
                    <label class="form-label small fw-semibold">Peran Pengguna *</label>
                    <select name="role" id="roleSelect" class="form-select" required>
                      <option value="mahasiswa">Mahasiswa</option>
                      <option value="dosen">Dosen</option>
                      <option value="admin">Administrator</option>
                    </select>
                  </div>

                  <div class="mb-3">
                    <label class="form-label small fw-semibold">Username / NIM *</label>
                    <input type="text" name="username" class="form-control" placeholder="Contoh: 2301020999 atau nama.dosen" required>
                  </div>

                  <div class="mb-3">
                    <label class="form-label small fw-semibold">Nama Lengkap *</label>
                    <input type="text" name="nama_lengkap" class="form-control" placeholder="Nama lengkap beserta gelar" required>
                  </div>

                  <div class="mb-3">
                    <label class="form-label small fw-semibold">Alamat Email</label>
                    <input type="email" name="email" class="form-control" placeholder="nama@umrah.ac.id">
                  </div>

                  <div class="mb-3">
                    <label class="form-label small fw-semibold">Password Default *</label>
                    <input type="password" name="password" class="form-control" placeholder="Minimal 8 karakter (Besar, Kecil, Angka, Simbol)" required>
                    <div class="form-text small text-muted">Contoh aman: <code>Password123!</code> (R-01 Kebijakan Password Kuat)</div>
                  </div>

                  <!-- Khusus Mahasiswa -->
                  <div id="mhsExtra">
                    <div class="mb-3">
                      <label class="form-label small fw-semibold">NIM Mahasiswa</label>
                      <input type="text" name="nim" class="form-control" placeholder="Nomor Induk Mahasiswa">
                    </div>
                    <div class="row">
                      <div class="col-md-6 mb-3">
                        <label class="form-label small fw-semibold">Angkatan</label>
                        <input type="number" name="angkatan" class="form-control" value="2026">
                      </div>
                      <div class="col-md-6 mb-3">
                        <label class="form-label small fw-semibold">Program Studi</label>
                        <input type="text" name="program_studi" class="form-control" value="Teknik Informatika">
                      </div>
                    </div>
                  </div>
                </div>

                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                  <button type="submit" class="btn btn-primary fw-semibold"><i class="bi bi-save me-1"></i>Buat Pengguna</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/public/js/app.js"></script>
  <script>
    const roleSelect = document.getElementById('roleSelect');
    const mhsExtra = document.getElementById('mhsExtra');
    roleSelect.addEventListener('change', () => {
      mhsExtra.style.display = roleSelect.value === 'mahasiswa' ? 'block' : 'none';
    });
  </script>
</body>
</html>

